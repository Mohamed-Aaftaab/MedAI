# Copy to .env and fill in real values. Never commit .env.
CALLE_API_KEY=calle_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CALLE_BASE_URL=https://api.heycall-e.com

# Your own number, for self-test calls. E.164 format.
TEST_PHONE=+1XXXXXXXXXX
TEST_REGION=IN
TEST_LOCALE=en-IN

# Optional: public URL for app.py's /calle/webhook (e.g. an ngrok tunnel),
# so CALL-E can deliver the terminal event instead of you polling for it.
# Leave blank to place calls without a webhook.
CALLE_WEBHOOK_URL=

# Durable local workflow (no live calling by default)
MEDAI_TENANT_ID=local
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MEDAI_STAFF_TOKEN=
# Optional absolute path; default is data/medai.sqlite3 next to app.py
MEDAI_DB_PATH=
MEDAI_PUBLIC_BASE_URL=
CALLE_ENABLE_LIVE_CALLS=false
CALLE_CALL_BUDGET=0
CALLE_ALLOWED_PHONES=
CALLE_VERIFIED_LOCALES=

# Optional production entrypoint (see PRODUCTION.md)
MEDAI_STAFF_KEYS=
MEDAI_ALLOWED_HOSTS=
MEDAI_ENABLE_LEGACY_DEMO=false

# KeeperHub — pay a small amount of Sepolia ETH before a campaign call.
# Create an organization + API key at https://app.keeperhub.com
# (Settings > Developer > API keys > Organisation keys) and fund its wallet
# with a little Sepolia testnet ETH before setting KEEPERHUB_ENABLE_PAYMENTS.
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_CHAIN_ID=11155111
# Address the campaign payment is sent to. Any address you control works for
# a demo; a real deployment would point this at whoever the payment is for.
KEEPERHUB_RECIPIENT_ADDRESS=
KEEPERHUB_TRANSFER_AMOUNT_ETH=0.0005
KEEPERHUB_ENABLE_PAYMENTS=false
# Guards POST /campaigns/keeperhub-webhook/{token}. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
KEEPERHUB_WEBHOOK_SECRET=

# Only needed for the KeeperHub-native workflow variant (optional — see
# README): running keeperhub_create_workflow.py, and later triggering that
# workflow directly. This is a *user webhook key* (wfb_ prefix, Settings >
# Developer > API keys > Webhook keys) — a different credential from
# KEEPERHUB_API_KEY above; POST /api/workflows/{id}/webhook rejects a kh_
# org key outright.
KEEPERHUB_WEBHOOK_KEY=
# Set after running keeperhub_create_workflow.py.
KEEPERHUB_WORKFLOW_ID=
